{
  "family": "datavision-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/datavision-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/datavision-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/datavision-api:latest",
      "essential": true,
      "cpu": 384,
      "memory": 1024,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "ASPNETCORE_ENVIRONMENT", "value": "Production" },
        { "name": "EnableSwagger", "value": "true" },
        {
          "name": "ConnectionStrings__DefaultConnection",
          "value": "Server=localhost,1433;Database=DataVisionDB;User Id=sa;TrustServerCertificate=true;MultipleActiveResultSets=true"
        },
        { "name": "JwtSettings__Issuer", "value": "DataVisionAPI" },
        { "name": "JwtSettings__Audience", "value": "DataVisionClients" },
        { "name": "JwtSettings__ExpiryInHours", "value": "24" }
      ],
      "secrets": [
        {
          "name": "ConnectionStrings__DefaultConnection__Password",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:datavision/mssql-sa-password"
        },
        {
          "name": "JwtSettings__SecretKey",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:datavision/jwt-secret"
        },
        {
          "name": "OpenWeatherMap__ApiKey",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:datavision/owm-api-key"
        }
      ],
      "dependsOn": [
        { "containerName": "db", "condition": "HEALTHY" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/datavision-api",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "api",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "db",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/datavision-mssql:2022",
      "essential": true,
      "cpu": 640,
      "memory": 2048,
      "environment": [
        { "name": "ACCEPT_EULA", "value": "Y" },
        { "name": "MSSQL_PID", "value": "Developer" }
      ],
      "secrets": [
        {
          "name": "MSSQL_SA_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:datavision/mssql-sa-password"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P \"$MSSQL_SA_PASSWORD\" -C -Q 'SELECT 1' || exit 1"
        ],
        "interval": 10,
        "timeout": 5,
        "retries": 10,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/datavision-api",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "db",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
